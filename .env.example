NODE_ENV=development
DATABASE_URL=postgresql://myschoolboard:local_dev_password@localhost:5433/myschoolboard?schema=public
TEST_DATABASE_URL=postgresql://myschoolboard:local_test_password@localhost:5434/myschoolboard_test?schema=public
TEST_DATABASE_DISPOSABLE=0
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DEV_ADMIN_EMAIL=admin@myschoolboard.test
DEV_ADMIN_PASSWORD=replace-this-local-password
ALLOW_DEMO_SEED=0
ALLOW_LOCAL_DB_RESET=0

# Phase 9 finance writes remain OFF until synthetic DB and security acceptance.
# Only enable with confirmed disposable development data for Phase 9 tests.
PHASE9_FEE_WRITE_ENABLED=false
# Manual school-admin transfer reference claims. Does not upload proof of funds.
PHASE9_PAYMENT_EVIDENCE_ENABLED=false
# Separate School Super Admin bank-reconciliation review, not provider settlement.
PHASE9_PAYMENT_REVIEW_ENABLED=false
# Explicitly allocate only independently verified manual claims; no actual bank settlement.
PHASE9_MANUAL_ALLOCATION_ENABLED=false
# Reverses only internal manual allocation previews after separate review.
# Never refunds money or changes an original financial transaction.
PHASE9_MANUAL_REVERSAL_ENABLED=false
