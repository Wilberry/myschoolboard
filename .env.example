NODE_ENV=development
DATABASE_URL=postgresql://myschoolboard:local_dev_password@localhost:5433/myschoolboard?schema=public
TEST_DATABASE_URL=postgresql://myschoolboard:local_test_password@localhost:5434/myschoolboard_test?schema=public
TEST_DATABASE_DISPOSABLE=0
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DEV_ADMIN_EMAIL=admin@myschoolboard.test
DEV_ADMIN_PASSWORD=replace-this-local-password
ALLOW_DEMO_SEED=0
ALLOW_LOCAL_DB_RESET=0

# Phase 8 report disclosure stays OFF unless a reviewed, fully tested
# deployment explicitly enables BOTH controls. Never enable automatically.
PHASE8_REPORT_RELEASE_ENABLED=false
PHASE8_REPORT_RECIPIENT_ACCESS_ENABLED=false
