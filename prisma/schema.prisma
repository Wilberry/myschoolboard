/** Immutable teacher-authored offline/written assessment definition. It is
 * not CBT, teacher marking approval or official grade publication. */
model AssessmentManualComponent {
  id String @id
  schoolId String
  sessionId String
  termId String
  classId String
  subjectId String
  assignmentId String
  teacherMembershipId String
  teacherUserId String
  kind AssessmentDraftKind
  title String @db.VarChar(180)
  maxPoints Int
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [schoolId, sessionId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualComponent_session_fkey")
  term AcademicTerm @relation(fields: [schoolId, sessionId, termId], references: [schoolId, sessionId, id], onDelete: NoAction, map: "AssessmentManualComponent_term_fkey")
  schoolClass SchoolClass @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualComponent_class_fkey")
  subject Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualComponent_subject_fkey")
  teacher Membership @relation(fields: [schoolId, teacherMembershipId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualComponent_teacher_fkey")
  assignment TeacherClassSubjectAssignment @relation(fields: [schoolId, assignmentId, teacherMembershipId, classId, subjectId, sessionId], references: [schoolId, id, membershipId, classId, subjectId, sessionId], onDelete: NoAction, map: "AssessmentManualComponent_assignment_fkey")
  marks AssessmentManualMarkProposal[]

  @@unique([schoolId, id])
  @@unique([schoolId, id, classId, sessionId])
  @@index([schoolId, classId, subjectId, termId])
}

/** Teacher's first score PROPOSAL for one student and manual component.
 * A different proposal, correction or release requires a separate reviewed
 * append-only decision design. Does NOT feed official or provisional grades. */
model AssessmentManualMarkProposal {
  id String @id
  schoolId String
  componentId String
  studentId String
  enrollmentId String
  classId String
  sessionId String
  earnedPoints Int
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  component AssessmentManualComponent @relation(fields: [schoolId, componentId, classId, sessionId], references: [schoolId, id, classId, sessionId], onDelete: NoAction, map: "AssessmentManualMarkProposal_component_fkey")
  student StudentRecord @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualMarkProposal_student_fkey")
  enrollment StudentEnrollment @relation(fields: [schoolId, enrollmentId, studentId, classId, sessionId], references: [schoolId, id, studentId, classId, sessionId], onDelete: NoAction, map: "AssessmentManualMarkProposal_enrollment_fkey")
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualMarkProposal_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, componentId, studentId])
  @@index([schoolId, studentId, createdAt])
  decision AssessmentManualMarkDecision?
  correctionRequests AssessmentManualCorrectionRequest[]
}

enum ManualMarkReviewAction {
  APPROVED
  RETURNED
}

/** Terminal verified-section decision on an initial teacher mark proposal.
 * No score mutation or publication, and no self-review. */
model AssessmentManualMarkDecision {
  id String @id
  schoolId String
  proposalId String
  reviewerMembershipId String
  reviewerUserId String
  action ManualMarkReviewAction
  reason String @db.VarChar(500)
  decidedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  proposal AssessmentManualMarkProposal @relation(fields: [schoolId, proposalId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualMarkDecision_proposal_fkey")
  reviewer Membership @relation(fields: [schoolId, reviewerMembershipId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualMarkDecision_reviewer_fkey")

  @@unique([schoolId, proposalId])
  @@index([schoolId, decidedAt])
}

/** Monotonic, immutable correction proposal by the original assigned teacher.
 * The SQL trigger assigns revision and verifies initial APPROVED decision.
 * A request by itself never changes effective marks. */
model AssessmentManualCorrectionRequest {
  id String @id
  schoolId String
  proposalId String
  revision Int @default(1)
  proposedPoints Int
  reason String @db.VarChar(500)
  requesterMembershipId String
  requesterUserId String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  proposal AssessmentManualMarkProposal @relation(fields: [schoolId, proposalId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualCorrectionRequest_proposal_fkey")
  requester Membership @relation(fields: [schoolId, requesterMembershipId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualCorrectionRequest_requester_fkey")
  decision AssessmentManualCorrectionDecision?

  @@unique([schoolId, id])
  @@unique([schoolId, proposalId, revision])
  @@index([schoolId, proposalId, createdAt])
}

/** Independent one-time verified-section decision for each correction.
 * Approved corrected values are derived, never written over earlier marks. */
model AssessmentManualCorrectionDecision {
  id String @id
  schoolId String
  requestId String
  reviewerMembershipId String
  reviewerUserId String
  action ManualMarkReviewAction
  reason String @db.VarChar(500)
  decidedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  request AssessmentManualCorrectionRequest @relation(fields: [schoolId, requestId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualCorrectionDecision_request_fkey")
  reviewer Membership @relation(fields: [schoolId, reviewerMembershipId], references: [schoolId, id], onDelete: NoAction, map: "AssessmentManualCorrectionDecision_reviewer_fkey")

  @@unique([schoolId, requestId])
  @@index([schoolId, decidedAt])
}

/** School Super Admin's explicit academic adoption of an immutable grading
 * profile for exactly one class/subject/session/term. Never report publication.
 * Later adoption changes do not silently rewrite previously frozen evidence. */
model ResultGradingAdoption {
  id String @id
  schoolId String
  policyId String
  sessionId String
  termId String
  classId String
  subjectId String
  ordinal Int @default(1)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  adoptedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  policy AssessmentGradingPolicyRevision @relation(fields: [schoolId, policyId], references: [schoolId, id], onDelete: NoAction, map: "ResultGradingAdoption_policy_fkey")
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ResultGradingAdoption_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, policyId])
  @@unique([schoolId, sessionId, termId, classId, subjectId, ordinal], map: "ResultGradingAdoption_context_ordinal_key")
  @@index([schoolId, classId, subjectId, termId])
  resultSheetEvidences ResultSheetEvidence[]
  resultFinalPublicationDecisions ResultFinalPublicationDecision[]
  resultReportCardSourcePackets ResultReportCardSourcePacket[]
}

/** Teacher-prepared frozen evidence. SourceManifest is ALWAYS computed
 * by SQL from reviewed scores, never accepted from the caller. This is not
 * an approved gradebook, official report card or public result. */
model ResultSheetEvidence {
  id String @id
  schoolId String
  sessionId String
  termId String
  classId String
  subjectId String
  assignmentId String
  teacherMembershipId String
  teacherUserId String
  adoptionId String
  revision Int @default(1)
  reason String @db.VarChar(500)
  sourceManifest Json @default("[]")
  studentCount Int @default(0)
  preparedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Membership @relation(fields: [schoolId, teacherMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ResultSheetEvidence_teacher_fkey")
  assignment TeacherClassSubjectAssignment @relation(fields: [schoolId, assignmentId, teacherMembershipId, classId, subjectId, sessionId], references: [schoolId, id, membershipId, classId, subjectId, sessionId], onDelete: NoAction, map: "ResultSheetEvidence_assignment_fkey")
  adoption ResultGradingAdoption @relation(fields: [schoolId, adoptionId], references: [schoolId, id], onDelete: NoAction, map: "ResultSheetEvidence_adoption_fkey")
  review ResultSheetReview?
  finalPublicationDecision ResultFinalPublicationDecision?
  resultReportCardSourcePackets ResultReportCardSourcePacket[]

  @@unique([schoolId, id])
  @@unique([schoolId, sessionId, termId, classId, subjectId, revision], map: "ResultSheetEvidence_context_revision_key")
  @@index([schoolId, teacherMembershipId, preparedAt])
}
/** Independent exact-section HM/Principal academic review of immutable
 * result evidence, not School Super Admin publication or student visibility. */
model ResultSheetReview {
  id String @id
  schoolId String
  evidenceId String
  reviewerMembershipId String
  reviewerUserId String
  action ManualMarkReviewAction
  reason String @db.VarChar(500)
  reviewedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  evidence ResultSheetEvidence @relation(fields: [schoolId, evidenceId], references: [schoolId, id], onDelete: NoAction, map: "ResultSheetReview_evidence_fkey")
  reviewer Membership @relation(fields: [schoolId, reviewerMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ResultSheetReview_reviewer_fkey")

  @@unique([schoolId, evidenceId])
  @@index([schoolId, reviewedAt])
}

/** Append-only final School Super Admin academic release authorization.
 * Not a public report card, disclosure, grade computation or recipient access.
 * The database trigger repeats current owner/section/source eligibility under
 * the school lock and assigns its contextual ordinal/timestamp itself. */
model ResultFinalPublicationDecision {
  id String @id
  schoolId String
  evidenceId String
  sessionId String
  termId String
  classId String
  subjectId String
  adoptionId String
  evidenceRevision Int
  ordinal Int @default(1)
  status String @default("APPROVED_AWAITING_RELEASE") @db.VarChar(40)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  decidedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  evidence ResultSheetEvidence @relation(fields: [schoolId, evidenceId], references: [schoolId, id], onDelete: NoAction, map: "ResultFinalPublicationDecision_evidence_fkey")
  adoption ResultGradingAdoption @relation(fields: [schoolId, adoptionId], references: [schoolId, id], onDelete: NoAction, map: "ResultFinalPublicationDecision_adoption_fkey")
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ResultFinalPublicationDecision_actor_fkey")
  sourcePacket ResultReportCardSourcePacket?
  privateOfficialReportCompositions PrivateOfficialReportComposition[]

  @@unique([schoolId, id])
  @@unique([schoolId, evidenceId])
  @@unique([schoolId, sessionId, termId, classId, subjectId, ordinal], map: "ResultFinalPublicationDecision_context_ordinal_key")
  @@index([schoolId, decidedAt])
}

/** Frozen, internal ONLY, per-pupil report-card source evidence packet.
 * NO calculated official grade, grade bands, downloadable document, public
 * release or student/guardian access. The trigger builds studentSourceCards
 * from the validated approved evidence, never caller-submitted pupil marks.
 * Future official report versions and visibility require separate workflows. */
model ResultReportCardSourcePacket {
  id String @id
  schoolId String
  finalDecisionId String
  evidenceId String
  adoptionId String
  sessionId String
  termId String
  classId String
  subjectId String
  evidenceRevision Int @default(1)
  finalDecisionOrdinal Int @default(1)
  studentCount Int @default(0)
  studentSourceCards Json @default("[]")
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  preparedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  finalDecision ResultFinalPublicationDecision @relation(fields: [schoolId, finalDecisionId], references: [schoolId, id], onDelete: NoAction, map: "ResultReportCardSourcePacket_finalDecision_fkey")
  evidence ResultSheetEvidence @relation(fields: [schoolId, evidenceId], references: [schoolId, id], onDelete: NoAction, map: "ResultReportCardSourcePacket_evidence_fkey")
  adoption ResultGradingAdoption @relation(fields: [schoolId, adoptionId], references: [schoolId, id], onDelete: NoAction, map: "ResultReportCardSourcePacket_adoption_fkey")
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ResultReportCardSourcePacket_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, finalDecisionId])
  @@index([schoolId, preparedAt])
  privateOfficialReportComposition PrivateOfficialReportComposition?
}

/** School-specific, append-only report grade-label and display rounding adoption.
 * Separate from assessment category weights and from report release. No default
 * grade bands; owner must explicitly adopt an exhaustive scale. */
model ReportGradeScaleRevision {
  id String @id
  schoolId String
  version Int @default(1)
  bands Json
  decimalPlaces Int
  roundingMode String @db.VarChar(16)
  bandBasis String @db.VarChar(24)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  adoptedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ReportGradeScaleRevision_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, version])
  @@index([schoolId, adoptedAt])
  privateOfficialReportCompositions PrivateOfficialReportComposition[]
}

/** School-adopted, immutable assessment-category aggregation semantics.
 * A report grading scale is a separate version and must be explicitly pinned
 * when a later official private composition artifact is authored. Neither
 * adopting this rule nor simulating its math publishes a pupil grade. */
model ReportAggregationRuleRevision {
  id String @id
  schoolId String
  version Int @default(1)
  categoryMethod String @db.VarChar(32)
  precisionMode String @db.VarChar(16)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  adoptedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ReportAggregationRuleRevision_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, version])
  @@index([schoolId, adoptedAt])
  privateOfficialReportCompositions PrivateOfficialReportComposition[]
}

/** Per-class/subject/term immutable INTERNAL official-result composition
 * evidence, built exclusively from DB-frozen reviewed source marks and exact
 * adopted aggregation/grade scale revisions. NOT released to recipients.
 * No API exposes composedStudentCards; public results remain disabled. */
model PrivateOfficialReportComposition {
  id String @id
  schoolId String
  sourcePacketId String
  finalDecisionId String
  evidenceId String
  adoptionId String
  sessionId String
  termId String
  classId String
  subjectId String
  evidenceRevision Int @default(1)
  aggregationRuleId String
  aggregationRuleVersion Int @default(1)
  gradeScaleId String
  gradeScaleVersion Int @default(1)
  studentCount Int @default(0)
  composedStudentCards Json @default("[]")
  status String @default("INTERNAL_OFFICIAL_EVIDENCE_NOT_RELEASED") @db.VarChar(64)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  composedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sourcePacket ResultReportCardSourcePacket @relation(fields: [schoolId, sourcePacketId], references: [schoolId, id], onDelete: NoAction, map: "PrivateOfficialReportComposition_packet_fkey")
  finalDecision ResultFinalPublicationDecision @relation(fields: [schoolId, finalDecisionId], references: [schoolId, id], onDelete: NoAction, map: "PrivateOfficialReportComposition_decision_fkey")
  aggregationRule ReportAggregationRuleRevision @relation(fields: [schoolId, aggregationRuleId], references: [schoolId, id], onDelete: NoAction, map: "PrivateOfficialReportComposition_aggregation_fkey")
  gradeScale ReportGradeScaleRevision @relation(fields: [schoolId, gradeScaleId], references: [schoolId, id], onDelete: NoAction, map: "PrivateOfficialReportComposition_scale_fkey")
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "PrivateOfficialReportComposition_actor_fkey")

  @@unique([schoolId, id])
  @@unique([schoolId, sourcePacketId])
  @@index([schoolId, composedAt])
  recipientReleases ReportRecipientRelease[]
}


/** Explicit owner-adopted four-mode tenant policy. No revision => deny all. */
model ReportVisibilityPolicyRevision {
  id String @id
  schoolId String
  version Int @default(1)
  mode ReportVisibilityMode
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  adoptedAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor Membership @relation(fields: [schoolId, actorMembershipId], references: [schoolId, id], onDelete: NoAction, map: "ReportVisibilityPolicyRevision_actor_fkey")
  releases ReportRecipientRelease[]

  @@unique([schoolId, id])
  @@unique([schoolId, version])
}

/** Independently approved immutable release of one frozen subject composition.
 * New ordinal per exact academic context supersedes older visible versions.
 */
model ReportRecipientRelease {
  id String @id
  schoolId String
  compositionId String
  visibilityPolicyId String
  visibilityPolicyVersion Int @default(1)
  sessionId String
  termId String
  classId String
  subjectId String
  releaseOrdinal Int @default(1)
  studentCount Int @default(0)
  reason String @db.VarChar(500)
  actorMembershipId String
  actorUserId String
  releasedAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
