  @@unique([schoolId, compositionId, visibilityPolicyId], map: "ReportRecipientRelease_composition_policy_key")
  @@unique([schoolId, sessionId, termId, classId, subjectId, releaseOrdinal], map: "ReportRecipientRelease_exact_ordinal_key")
  @@index([schoolId, sessionId, termId, classId, releasedAt], map: "ReportRecipientRelease_school_context_time_idx")
}

/** A guardian's explicit receipt of one exact released version for one child.
